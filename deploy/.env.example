# Copy to deploy/.env (gitignored). Fill locally / on the host.
TS_AUTHKEY=             # Tailscale sidecar auth key (Settings > Keys). Reusable,
                        # not ephemeral -- container restarts must not need re-auth.
                        # Funnel must be enabled for this node in the tailnet admin
                        # console FIRST (Settings > HTTPS Certificates, and the
                        # node's Funnel attribute) -- compose can't do this step.
TS_HOSTNAME=            # Tailnet device name; also fixes the public
                        # <name>.<tailnet>.ts.net Funnel address. Defaults to
                        # "train-tracker-query-web" if unset.
