# Copy to service/.env (gitignored). Fill locally / on the host.

# Groq API key (console.groq.com) -- used for STT (Whisper Large v3
# Turbo), Gate 1/Gate 2 classification+extraction, composition, and TTS.
GROQ_API_KEY=

# Base URL of train-tracker's public API (this project's own data
# source -- never call any upstream transit provider directly).
TRAIN_TRACKER_API_BASE_URL=

# Langfuse Cloud (cloud.langfuse.com) project keys -- trace-per-query /
# span-per-stage observability and cost tracking. Tracing is a no-op if
# either key is unset (safe for local dev).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
